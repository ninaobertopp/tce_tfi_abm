    public gridLattice(int xDim, int yDim, String outFileName, Rand rng, int seed) {
        //Calls the constructor of the parent class (AgentGrid2D).
        super(xDim, yDim, agentLattice.class, true, true);
        this.rn = rng;
        output = new FileIO(outFileName, "w");
        output.Write("Seed," + seed + "\n");
        output.Write("Day,Total_CD8_TILs,Total_Tumor,Active_CD8_Tcells,Exhausted_CD8_Tcells,Inactive_CD8_Tcells,%_Exhausted_CD8_Tcells,TCE_ON\n");


        double totalArea = xDim * yDim;

// Initialize cells at 50% confluency with a 1:4 E:T ratio
        double confluency = 0.5;
        int numTumorCells = (int) (totalArea * confluency * 0.80); // 80% of occupied sites = 40% of full grid
        int numTCells = (int) (totalArea * confluency * 0.20); // 20% of occupied sites = 10% of full grid

        for (int i = 0; i < numTumorCells; i++) {
            int xinit, yinit;
            do {
                xinit = rn.Int(xDim);
                yinit = rn.Int(yDim);
            } while (PopAt(xinit, yinit) > 0);

            agentLattice c = NewAgentSQ(xinit, yinit);
            c.type = Tumor;
            c.SetCellColor();
            totalTumorCells++; // track total tumor cells
        }

// All T cells are initialized in the inactive state.
// Active T cells arise only after TCE exposure, and exhausted T cells emerge dynamically during simulation.
        int numInactiveTCells = numTCells;

// Place inactive T cells
        for (int i = 0; i < numInactiveTCells; i++) {
            int xinit, yinit;
            do {
                xinit = rn.Int(xDim);
                yinit = rn.Int(yDim);
            } while (PopAt(xinit, yinit) > 0); // ensure no overlap

            agentLattice c = NewAgentSQ(xinit, yinit);
            c.type = inactiveTcell;
            c.SetCellColor();
        }
    }

