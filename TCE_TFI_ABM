/**
 * Agent-based model of TCE (T-cell engager) therapy with treatment-free
 * intervals (TFI), tumor cells, and CD8+ T cells in three states
 * (inactive, active, exhausted).
 * <p>
 * Time convention: all {@code hours_since_*} fields and {@code timeStep}
 * are tracked in simulation hours. {@code day}, {@code TCE_start}, and
 * {@code TCE_Duration} are tracked in days (1 day = 24 simulation hours).
 * <p>
 * Two grid "phases" are modeled:
 * <ul>
 *   <li>in vitro phase: a co-culture grid seeded with tumor cells and
 *       inactive T cells, tumor cells reset to a fixed effector:target
 *       ratio every 7 days, no tumor proliferation.</li>
 *   <li>ACT (adoptive cell transfer) phase: harvested T cells are
 *       transferred into a fresh grid seeded with tumor cells that do
 *       proliferate, modeling an in vivo-like environment.</li>
 * </ul>
 */
class GridLattice extends AgentGrid2D<AgentLattice> {

    // -----------------------------------------------------------------
    // Cell type identifiers (values chosen to match legacy output files;
    // do not renumber without updating downstream analysis scripts)
    // -----------------------------------------------------------------
    public static final int ACTIVE_TCELL = 1;
    public static final int TUMOR = 2;
    public static final int EXHAUSTED_TCELL = 4;
    public static final int INACTIVE_TCELL = 6;

    // -----------------------------------------------------------------
    // Model constants
    // -----------------------------------------------------------------

    /** Simulation length of the in vitro phase, in hours (30 days). */
    public static final double IN_VITRO_STEPS = 30 * 24.0;

    /** Length of the ACT (in vivo) phase, in days. */
    public static final int ACT_PHASE_DURATION_DAYS = 16;

    /** Day (within the in vitro phase) on which T cells are harvested for ACT. */
    public static final int HARVEST_DAY = 14;

    /** Number of T cells transferred into the ACT-phase grid at harvest. */
    public static final int N_TCELLS_TRANSFERRED = 200;

    /** Number of fresh tumor cells seeded into the ACT-phase grid at harvest. */
    public static final int N_TUMORS_SEEDED_ACT = 1000;

    /** Interval (days) at which in vitro tumor cells are reset to the target E:T ratio. */
    public static final int TUMOR_RESET_INTERVAL_DAYS = 7;

    /** Target tumor:T-cell ratio used when resetting in vitro tumor cells (e.g. 4.0 = 1:4 E:T). */
    public static final double TARGET_TUMOR_TCELL_RATIO = 4.0;

    /** Initial confluency (fraction of grid sites occupied) at seeding. */
    public static final double INITIAL_CONFLUENCY = 0.5;

    /** Fraction of occupied sites that are tumor cells at seeding (remainder are T cells). */
    public static final double INITIAL_TUMOR_FRACTION = 0.80;

    /**
     * Exhausted CD8+ T-cell death rate (per hour).
     * <p>
     * Set to 1/72 h⁻¹ (~40% cumulative death over 10 days assuming
     * exponential decay). Note this is higher than the rate implied by
     * literature-derived in vitro CD8+ T-cell survival kinetics
     * (Hedfors &amp; Brinchmann, Scand J Immunol, 2003), which would
     * predict ≈0.00213 h⁻¹ for the same 40% target. The higher value
     * used here reflects [TODO: state the empirical/fitting justification,
     * e.g. calibration against dataset X, or note if this should instead
     * be reconciled with the literature-derived rate before submission].
     */
    public static double p_death_exh = 1.0 / 72.0;

    /** Probability per hour that an exhausted T cell reactivates to the active state under TCE. */
    public static final double P_EXHAUSTED_REACTIVATION = 0.0005;

    /** Number of movement/interaction attempts a T cell makes per simulation step. */
    public static final int MOVE_ATTEMPTS = 3;

    /** Minimum hours since last kill before an active T cell can kill again. */
    public static final double MIN_HOURS_BETWEEN_KILLS = 12.0;

    /** Minimum hours since last division before an active T cell can divide again. */
    public static final double MIN_HOURS_BETWEEN_DIVISIONS = 5.0;

    /** Active-T-cell division probability per opportunity during the in vitro phase. */
    public static final double DIV_PROB_IN_VITRO = 0.10;

    /** Active-T-cell division probability per opportunity during the ACT (in vivo) phase. */
    public static final double DIV_PROB_ACT_PHASE = 1.0;

    /** PD-1 gained per tumor kill outside of active TCE exposure. */
    public static final double PD1_GAIN_PER_KILL_BASE = 1.0;

    /** Multiplier applied to PD-1 gain per kill while TCE is active. */
    public static final double PD1_GAIN_TCE_MULTIPLIER = 2.0;

    /** Sigmoid midpoint (PD-1 level) for kill-suppression probability. */
    public static final double SUPPRESSION_SIGMOID_MIDPOINT = 10.0;

    /** Sigmoid steepness for kill-suppression probability. */
    public static final double SUPPRESSION_SIGMOID_STEEPNESS = 0.7;

    /** Sigmoid midpoint (PD-1 level) for the active-to-exhausted transition probability. */
    public static final double EXHAUSTION_SIGMOID_MIDPOINT = 14.0;

    /** Sigmoid steepness for the active-to-exhausted transition probability. */
    public static final double EXHAUSTION_SIGMOID_STEEPNESS = 0.7;

    /** Multiplier applied to kill-success probability during the ACT (in vivo) phase. */
    public static final double ACT_PHASE_KILL_BOOST = 2.0;

    /** Tumor proliferation probability per hour during the ACT (in vivo) phase. */
    public static final double TUMOR_PROLIF_PROB_ACT = 1.0 / 72.0;

    /** Tumor proliferation probability per hour during the in vitro phase (irradiated, static). */
    public static final double TUMOR_PROLIF_PROB_IN_VITRO = 0.0;

    /** Inactive-T-cell division probability per hour when a tumor kill occurred recently. */
    public static final double INACTIVE_DIV_PROB = 1.0 / 120.0;

    /** Window (days since last tumor kill) within which inactive T cells may still divide. */
    public static final int RECENT_KILL_WINDOW_DAYS = 3;

    /** Half-life (days) for active-to-inactive reversion when TCE is off. */
    public static final double ACTIVE_TO_INACTIVE_HALF_LIFE_DAYS = 210.0 / 24.0;

    // -----------------------------------------------------------------
    // Mutable simulation state
    // -----------------------------------------------------------------
    public static int timeStep = 0;
    public double cached_CD8_TIL_count = 0;
    public int totalTumorCells = 0;
    public int daysSinceTumorKill = 4;

    boolean TCE_ON;
    boolean ACT_PHASE = false;

    /**
     * TCE dosing schedule. {@code TCE_start[k]} is the day treatment period
     * k begins; {@code TCE_Duration[k]} is how many days it lasts. Arrays
     * must be the same length. Loaded from {@link SimConfig}.
     */
    double[] TCE_start;
    double[] TCE_Duration;

    public Rand rn;
    FileIO output;

    // -----------------------------------------------------------------
    // Constructors
    // -----------------------------------------------------------------

    /** Constructs the initial in vitro co-culture grid (tumor cells + inactive T cells). */
    public GridLattice(int xDim, int yDim, String outFileName, Rand rng, int seed, SimConfig config) {
        super(xDim, yDim, AgentLattice.class, true, true);
        this.rn = rng;
        this.TCE_start = config.tceStart;
        this.TCE_Duration = config.tceDuration;
        validateSchedule();

        output = new FileIO(outFileName, "w");
        output.Write("Seed," + seed + "\n");
        output.Write("Day,Total_CD8_TILs,Total_Tumor,Active_CD8_Tcells,Exhausted_CD8_Tcells,"
                + "Inactive_CD8_Tcells,%_Exhausted_CD8_Tcells,TCE_ON\n");

        double totalArea = xDim * yDim;
        int numTumorCells = (int) (totalArea * INITIAL_CONFLUENCY * INITIAL_TUMOR_FRACTION);
        int numTCells = (int) (totalArea * INITIAL_CONFLUENCY * (1.0 - INITIAL_TUMOR_FRACTION));

        for (int i = 0; i < numTumorCells; i++) {
            int[] xy = randomEmptySite(xDim, yDim);
            AgentLattice c = NewAgentSQ(xy[0], xy[1]);
            c.type = TUMOR;
            c.SetCellColor();
            totalTumorCells++;
        }

        // All T cells start inactive; active/exhausted states emerge dynamically.
        for (int i = 0; i < numTCells; i++) {
            int[] xy = randomEmptySite(xDim, yDim);
            AgentLattice c = NewAgentSQ(xy[0], xy[1]);
            c.type = INACTIVE_TCELL;
            c.SetCellColor();
        }
    }

    /** Constructs an empty grid used to receive transferred T cells during the ACT phase. */
    public GridLattice(int xDim, int yDim, String outFileName, Rand rng, SimConfig config) {
        super(xDim, yDim, AgentLattice.class, true, true);
        this.rn = rng;
        this.ACT_PHASE = true;
        this.TCE_start = config.tceStart;
        this.TCE_Duration = config.tceDuration;

        output = new FileIO(outFileName, "w");
        output.Write("Day,Total_CD8_TILs,Total_Tumor,Active_CD8_Tcells,Exhausted_CD8_Tcells,"
                + "Inactive_CD8_Tcells,%_Exhausted_CD8_Tcells,TCE_ON\n");
    }

    private void validateSchedule() {
        if (TCE_start.length != TCE_Duration.length) {
            throw new IllegalArgumentException(
                    "TCE_start and TCE_Duration must be the same length (got "
                            + TCE_start.length + " and " + TCE_Duration.length + ")");
        }
    }

    private int[] randomEmptySite(int xDim, int yDim) {
        int x, y;
        do {
            x = rn.Int(xDim);
            y = rn.Int(yDim);
        } while (PopAt(x, y) > 0);
        return new int[]{x, y};
    }

    // -----------------------------------------------------------------
    // Grid methods
    // -----------------------------------------------------------------

    /** Renders the current grid state into the given visualization window. */
    public void Draw(UIGrid vis) {
        for (int x = 0; x < xDim; x++) {
            for (int y = 0; y < yDim; y++) {
                AgentLattice drawMe = GetAgent(x, y);
                vis.SetPix(x, y, drawMe != null ? drawMe.color : RGB256(240, 220, 220));
            }
        }
    }

    /**
     * Tallies current cell populations.
     *
     * @return array indexed as: [0] total CD8 T cells (active+exhausted+inactive),
     * [1] total tumor cells, [2] active T cells, [3] exhausted T cells,
     * [4] inactive T cells, [5] percent of T cells that are exhausted.
     */
    public double[] CellCounts() {
        double[] counts = new double[6];
        for (AgentLattice c : this) {
            if (c.type == ACTIVE_TCELL) counts[2]++;
            else if (c.type == EXHAUSTED_TCELL) counts[3]++;
            else if (c.type == INACTIVE_TCELL) counts[4]++;
            else if (c.type == TUMOR) counts[1]++;
        }
        counts[0] = counts[2] + counts[3] + counts[4];
        counts[5] = (counts[0] > 0) ? (counts[3] / counts[0]) * 100.0 : 0.0;
        return counts;
    }

    /** Collects the state of every T cell currently on the grid, for transfer to a new grid. */
    public ArrayList<TcellState> HarvestTcells() {
        ArrayList<TcellState> harvested = new ArrayList<>();
        for (AgentLattice c : this) {
            if (c.type == ACTIVE_TCELL || c.type == EXHAUSTED_TCELL || c.type == INACTIVE_TCELL) {
                harvested.add(new TcellState(c.type, c.pd_1, c.tcellAge,
                        c.hours_since_activation, c.hours_since_division, c.hours_since_kill));
            }
        }
        return harvested;
    }

    /** Removes all tumor cells and reseeds them at the given tumor:T-cell ratio. */
    public void ResetTumorsToETRatio(double targetRatio) {
        int tCellCount = 0;
        for (AgentLattice c : this) {
            if (c.type == ACTIVE_TCELL || c.type == INACTIVE_TCELL || c.type == EXHAUSTED_TCELL) {
                tCellCount++;
            }
        }
        for (AgentLattice c : this) {
            if (c.type == TUMOR) c.Dispose();
        }

        int targetTumorCells = (int) (targetRatio * tCellCount);
        int emptySites = (xDim * yDim) - tCellCount;
        targetTumorCells = Math.min(targetTumorCells, emptySites);

        for (int i = 0; i < targetTumorCells; i++) {
            int[] xy = randomEmptySiteOccupiedCheck();
            AgentLattice tumor = NewAgentSQ(xy[0], xy[1]);
            tumor.type = TUMOR;
            tumor.SetCellColor();
        }
        totalTumorCells = targetTumorCells;
    }

    private int[] randomEmptySiteOccupiedCheck() {
        int x, y;
        do {
            x = rn.Int(xDim);
            y = rn.Int(yDim);
        } while (GetAgent(x, y) != null);
        return new int[]{x, y};
    }

    /** Writes one row of daily summary output to the given CSV file handle. */
    public void RecordOut(FileIO writeHere, int time, double[] cts, boolean tceOnFlag) {
        writeHere.Write(time + ",");
        for (double v : cts) {
            writeHere.Write(String.format("%.2f", v));
            writeHere.Write(",");
        }
        writeHere.Write((tceOnFlag ? "true" : "false") + "\n");
    }

    /** Prints a brief per-day status line to stdout (gated by {@link SimConfig#verbose}). */
    public void PrintDailyStatus(int day, boolean verbose) {
        if (!verbose) return;
        System.out.println("Day " + day);
        System.out.println("daysSinceTumorKill = " + this.daysSinceTumorKill);
        System.out.println("TCE_ON = " + this.TCE_ON);
    }

    /** Seeds fresh tumor cells into an empty (typically ACT-phase) grid. */
    public void SeedFreshTumors(int numTumors) {
        for (int i = 0; i < numTumors; i++) {
            int[] xy = randomEmptySiteOccupiedCheck();
            AgentLattice tumor = NewAgentSQ(xy[0], xy[1]);
            tumor.type = TUMOR;
            tumor.SetCellColor();
        }
        totalTumorCells = numTumors;
    }

    /**
     * Randomly places up to {@code numToTransfer} harvested T cells onto this grid,
     * preserving each cell's prior state, and logs each transferred cell's
     * phenotype to {@code ACTcellOutput}.
     */
    public void InjectTransferredTcells(ArrayList<TcellState> transferredCells,
                                         int numToTransfer, FileIO ACTcellOutput) {
        int transferred = 0;
        while (transferred < numToTransfer && !transferredCells.isEmpty()) {
            int x = rn.Int(xDim);
            int y = rn.Int(yDim);
            if (GetAgent(x, y) != null) continue;

            int randomIndex = rn.Int(transferredCells.size());
            TcellState state = transferredCells.remove(randomIndex);

            String phenotype;
            if (state.type == ACTIVE_TCELL) phenotype = "ACTIVE";
            else if (state.type == EXHAUSTED_TCELL) phenotype = "EXHAUSTED";
            else phenotype = "INACTIVE";

            ACTcellOutput.Write(transferred + "," + phenotype + "," + state.pd_1 + ","
                    + state.tcellAge + "," + state.hours_since_activation + ","
                    + state.hours_since_division + "," + state.hours_since_kill + "\n");

            AgentLattice cell = NewAgentSQ(x, y);
            cell.type = state.type;
            cell.pd_1 = state.pd_1;
            cell.tcellAge = state.tcellAge;
            cell.hours_since_activation = state.hours_since_activation;
            cell.hours_since_division = state.hours_since_division;
            cell.hours_since_kill = state.hours_since_kill;
            cell.SetCellColor();

            transferred++;
        }
        System.out.println("Transferred T cells = " + transferred);
    }

    /** Saves a PNG snapshot of the current grid state, upscaled by {@code scale}. */
    public void savePNG(String filePath, int scale) {
        int w = xDim * scale, h = yDim * scale;
        BufferedImage img = new BufferedImage(w, h, BufferedImage.TYPE_INT_ARGB);
        for (int x = 0; x < xDim; x++) {
            for (int y = 0; y < yDim; y++) {
                AgentLattice a = GetAgent(x, y);
                int col = (a != null) ? a.color : RGB256(240, 220, 220);
                int argb = 0xFF000000 | (col & 0x00FFFFFF);
                int x0 = x * scale, y0 = y * scale;
                for (int dx = 0; dx < scale; dx++) {
                    for (int dy = 0; dy < scale; dy++) {
                        img.setRGB(x0 + dx, y0 + dy, argb);
                    }
                }
            }
        }
        try {
            ImageIO.write(img, "png", new File(filePath));
        } catch (IOException e) {
            System.err.println("Failed to write PNG to " + filePath + ": " + e.getMessage());
        }
    }

    /** Advances the simulation by one hour: agent updates plus once-daily bookkeeping. */
    public void ModelStep(double timeStep, double day) {
        GridLattice.timeStep = (int) timeStep;
        cached_CD8_TIL_count = CellCounts()[0];

        ShuffleAgents(rn);
        for (AgentLattice c : this) {
            c.CellStep();
        }

        totalTumorCells = 0;
        for (AgentLattice c : this) {
            if (c.type == TUMOR) totalTumorCells++;
        }

        if (timeStep % 24 == 0 && timeStep != 0) {
            if (!ACT_PHASE && timeStep % (TUMOR_RESET_INTERVAL_DAYS * 24) == 0) {
                ResetTumorsToETRatio(TARGET_TUMOR_TCELL_RATIO);
            }

            // Active -> inactive reversion via half-life decay, only while TCE is off.
            if (!TCE_ON) {
                for (AgentLattice cell : this) {
                    if (cell.type == ACTIVE_TCELL && cell.hours_since_activation >= 24) {
                        double t_days = cell.hours_since_activation / 24.0;
                        double decayProb = 1.0 - Math.exp(
                                -Math.log(2) * t_days / ACTIVE_TO_INACTIVE_HALF_LIFE_DAYS);
                        if (rn.Double() < decayProb) {
                            cell.type = INACTIVE_TCELL;
                            cell.SetCellColor();
                        }
                    }
                }
            }
        }
    }

    // -------------------------------------------------------------
    // MAIN
    // -------------------------------------------------------------
    public static void main(String[] args) throws IOException {
        SimConfig config = SimConfig.load(args.length > 0 ? args[0] : null);

        java.text.SimpleDateFormat dateFormat = new java.text.SimpleDateFormat("yyyy-MM-dd_HH_ss");
        String date_time = dateFormat.format(new java.util.Date());

        for (int run = 0; run < config.nRuns; run++) {
            runReplicate(run, date_time, config);
        }
    }

    private static void runReplicate(int run, String date_time, SimConfig config) throws IOException {
        System.out.println("=== RUN " + run + " | SEED: " + run + " ===");

        double day = 1;
        int xDim = config.xDim;
        int yDim = config.yDim;
        double TIMESTEPS = IN_VITRO_STEPS;

        String setting_dir = Paths.get(config.outputRoot,
                config.simLabel + "_" + date_time).toString() + File.separator;
        new File(setting_dir).mkdirs();
        String path_to_output_file = setting_dir + config.simLabel + "_rep" + run + ".csv";

        String frameDir = setting_dir + String.format("frames_rep%02d/", run);
        if (config.visuals) new File(frameDir).mkdirs();

        UIGrid Cell_vis = new UIGrid(xDim, yDim, 4, 2, 5);
        UIWindow win = new UIWindow("TCE_TFI");
        win.AddCol(0, Cell_vis);
        UILabel dayLabel = new UILabel("Day: 1");
        win.AddCol(1, dayLabel);
        UILabel tceLabel = new UILabel("TCE: OFF");
        win.AddCol(1, tceLabel);
        if (config.visuals) win.RunGui();

        Rand runRNG = new Rand(run);
        GridLattice g = new GridLattice(xDim, yDim, path_to_output_file, runRNG, run, config);

        try {
            for (int i = 0; i < TIMESTEPS; i++) {
                timeStep = i;
                g.TCE_ON = isTceOn(day, g.TCE_start, g.TCE_Duration);
                tceLabel.SetText(g.TCE_ON ? "TCE: ON" : "TCE: OFF");

                double[] cell_count = g.CellCounts();
                if (i % 24 == 0) dayLabel.SetText("Day: " + (int) day);

                g.ModelStep(timeStep, day);

                boolean isHarvestMoment = ((int) day == HARVEST_DAY) && (i % 24 == 23);
                if (isHarvestMoment) {
                    g.PrintDailyStatus((int) day, config.verbose);
                    g.RecordOut(g.output, (int) day, cell_count, g.TCE_ON);
                    g.daysSinceTumorKill++;

                    if (config.visuals) {
                        g.savePNG(frameDir + String.format("day_%02d.png", (int) day), 4);
                    }

                    if (!config.inVitroOnly) {
                        runActPhase(g, run, date_time, setting_dir, config, win, Cell_vis, dayLabel, tceLabel);
                        break;
                    }
                    day += 1;
                    continue;
                }

                if (config.visuals) {
                    g.Draw(Cell_vis);
                    win.TickPause(100);
                }

                if (i % 24.0 == 23) {
                    g.PrintDailyStatus((int) day, config.verbose);
                    g.RecordOut(g.output, (int) day, cell_count, g.TCE_ON);
                    g.daysSinceTumorKill++;
                    if (config.visuals) {
                        g.savePNG(frameDir + String.format("day_%02d.png", (int) day), 4);
                    }
                    day += 1;
                }
            }
        } finally {
            g.output.Close();
        }
    }

    /** Runs the ACT (in vivo transfer) phase following T-cell harvest from the in vitro grid. */
    private static void runActPhase(GridLattice g, int run, String date_time, String setting_dir,
                                     SimConfig config, UIWindow win, UIGrid Cell_vis,
                                     UILabel dayLabel, UILabel tceLabel) throws IOException {
        ArrayList<TcellState> transferredCells = g.HarvestTcells();
        System.out.println("Harvested T cells = " + transferredCells.size());

        String actCellFile = setting_dir + "ACTcells_" + date_time + "_Day" + HARVEST_DAY
                + "_rep" + run + ".csv";
        FileIO actCellOutput = new FileIO(actCellFile, "w");
        actCellOutput.Write("CellID,Type,PD1,TcellAge,HoursSinceActivation,"
                + "HoursSinceDivision,HoursSinceKill\n");

        String newOutputFile = setting_dir + "ACT_" + date_time + "_Day" + HARVEST_DAY
                + "_rep" + run + ".csv";
        GridLattice transferGrid = new GridLattice(g.xDim, g.yDim, newOutputFile, g.rn, config);

        transferGrid.SeedFreshTumors(N_TUMORS_SEEDED_ACT);
        transferGrid.InjectTransferredTcells(transferredCells, N_TCELLS_TRANSFERRED, actCellOutput);
        actCellOutput.Close();

        double[] day0Counts = transferGrid.CellCounts();
        transferGrid.RecordOut(transferGrid.output, 0, day0Counts, false);
        System.out.println("Fresh tumors seeded into transfer grid");

        try {
            for (int t = 0; t < ACT_PHASE_DURATION_DAYS * 24; t++) {
                int actDay = (t / 24) + 1;
                transferGrid.TCE_ON = isActPhaseTceOn(actDay, config);

                if (t % 24 == 0) {
                    dayLabel.SetText("ACT Day: " + actDay);
                    tceLabel.SetText(transferGrid.TCE_ON ? "TCE: ON" : "TCE: OFF");
                }

                if (config.visuals) {
                    transferGrid.Draw(Cell_vis);
                    win.TickPause(100);
                }

                transferGrid.ModelStep(t, actDay);

                if (t % 24 == 0) {
                    double[] transferCounts = transferGrid.CellCounts();
                    transferGrid.PrintDailyStatus(actDay, config.verbose);
                    transferGrid.RecordOut(transferGrid.output, actDay, transferCounts, transferGrid.TCE_ON);
                    transferGrid.daysSinceTumorKill++;
                }
            }
        } finally {
            transferGrid.output.Close();
        }
    }

    /** ACT-phase TCE schedule: on for one day at ACT-day 2 and again at ACT-day 9. */
    private static boolean isActPhaseTceOn(int actDay, SimConfig config) {
        return actDay == config.actTceDay1 || actDay == config.actTceDay2;
    }

    private static boolean isTceOn(double day, double[] tceStart, double[] tceDuration) {
        for (int k = 0; k < tceStart.length; k++) {
            if (day >= tceStart[k] && day <= tceStart[k] + tceDuration[k] - 1) {
                return true;
            }
        }
        return false;
    }
}

/**
 * Run configuration, loaded from a {@code .properties} file if a path is given
 * as the first command-line argument, otherwise from defaults below. Keeping
 * these settings out of source code means each run's parameters can be saved
 * alongside its output for reproducibility, rather than requiring a source diff.
 * <p>
 * Example properties file:
 * <pre>
 * simLabel=TFI_7on7off
 * nRuns=50
 * xDim=160
 * yDim=150
 * outputRoot=TCE_TFI/output
 * visuals=false
 * verbose=true
 * inVitroOnly=false
 * tceStart=1,15
 * tceDuration=7,7
 * actTceDay1=2
 * actTceDay2=9
 * </pre>
 */
class SimConfig {
    String simLabel = "TFI_7on7off";
    int nRuns = 50;
    int xDim = 160;
    int yDim = 150;
    String outputRoot = "TCE_TFI" + File.separator + "output";
    boolean visuals = false;
    boolean verbose = true;
    boolean inVitroOnly = false;
    double[] tceStart = {1};
    double[] tceDuration = {7};
    int actTceDay1 = 2;
    int actTceDay2 = 9;

    static SimConfig load(String propsPath) throws IOException {
        SimConfig config = new SimConfig();
        if (propsPath == null) return config;

        Properties p = new Properties();
        try (FileInputStream in = new FileInputStream(propsPath)) {
            p.load(in);
        }
        config.simLabel = p.getProperty("simLabel", config.simLabel);
        config.nRuns = Integer.parseInt(p.getProperty("nRuns", String.valueOf(config.nRuns)));
        config.xDim = Integer.parseInt(p.getProperty("xDim", String.valueOf(config.xDim)));
        config.yDim = Integer.parseInt(p.getProperty("yDim", String.valueOf(config.yDim)));
        config.outputRoot = p.getProperty("outputRoot", config.outputRoot);
        config.visuals = Boolean.parseBoolean(p.getProperty("visuals", String.valueOf(config.visuals)));
        config.verbose = Boolean.parseBoolean(p.getProperty("verbose", String.valueOf(config.verbose)));
        config.inVitroOnly = Boolean.parseBoolean(p.getProperty("inVitroOnly", String.valueOf(config.inVitroOnly)));
        config.tceStart = parseDoubleArray(p.getProperty("tceStart"), config.tceStart);
        config.tceDuration = parseDoubleArray(p.getProperty("tceDuration"), config.tceDuration);
        config.actTceDay1 = Integer.parseInt(p.getProperty("actTceDay1", String.valueOf(config.actTceDay1)));
        config.actTceDay2 = Integer.parseInt(p.getProperty("actTceDay2", String.valueOf(config.actTceDay2)));

        if (config.tceStart.length != config.tceDuration.length) {
            throw new IllegalArgumentException("tceStart and tceDuration must have the same length");
        }
        return config;
    }

    private static double[] parseDoubleArray(String csv, double[] fallback) {
        if (csv == null || csv.isBlank()) return fallback;
        String[] parts = csv.split(",");
        double[] result = new double[parts.length];
        for (int i = 0; i < parts.length; i++) {
            result[i] = Double.parseDouble(parts[i].trim());
        }
        return result;
    }
}

/** Snapshot of a single T cell's state, used to transfer cells between grids. */
class TcellState {
    final int type;
    final double pd_1;
    final double tcellAge;
    final double hours_since_activation;
    final double hours_since_division;
    final double hours_since_kill;

    public TcellState(int type, double pd_1, double tcellAge, double hours_since_activation,
                       double hours_since_division, double hours_since_kill) {
        this.type = type;
        this.pd_1 = pd_1;
        this.tcellAge = tcellAge;
        this.hours_since_activation = hours_since_activation;
        this.hours_since_division = hours_since_division;
        this.hours_since_kill = hours_since_kill;
    }
}

/** A single agent on the grid: either a tumor cell or a CD8+ T cell in one of three states. */
class AgentLattice extends AgentSQ2Dunstackable<GridLattice> {
    public int type;
    int color;
    double pd_1 = 0;
    double tcellAge = 0;
    double hours_since_kill = 0;
    public double hours_since_activation = 0;
    public double hours_since_division = 0;

    static final int COLOR_ACTIVE = RGB256(10, 200, 150);
    static final int COLOR_EXHAUSTED = RGB256(200, 50, 250);
    static final int COLOR_TUMOR = RGB256(47, 32, 66);
    static final int COLOR_INACTIVE = RGB256(255, 165, 0);

    static int categoricalColor(int type) {
        switch (type) {
            case ACTIVE_TCELL: return COLOR_ACTIVE;
            case EXHAUSTED_TCELL: return COLOR_EXHAUSTED;
            case TUMOR: return COLOR_TUMOR;
            case INACTIVE_TCELL: return COLOR_INACTIVE;
            default: throw new IllegalArgumentException("Unknown cell type: " + type);
        }
    }

    void SetCellColor() {
        color = categoricalColor(type);
    }

    /** Removes a tumor cell that has been killed and resets the time-since-kill clock. */
    void Tcell_Kill() {
        if (type == TUMOR && G.totalTumorCells > 0) {
            G.totalTumorCells--;
        }
        G.daysSinceTumorKill = 0;
        this.Dispose();
    }

    /** Probability that PD-1 level {@code pd1} suppresses a kill attempt (logistic function). */
    private static double suppressionProbability(double pd1) {
        return 1.0 / (1.0 + Math.exp(-SUPPRESSION_SIGMOID_STEEPNESS * (pd1 - SUPPRESSION_SIGMOID_MIDPOINT)));
    }

    /** Probability that PD-1 level {@code pd1} triggers active-to-exhausted transition. */
    private static double exhaustionProbability(double pd1) {
        return 1.0 / (1.0 + Math.exp(-EXHAUSTION_SIGMOID_STEEPNESS * (pd1 - EXHAUSTION_SIGMOID_MIDPOINT)));
    }

    /** Attempts one random move into an empty Moore-neighborhood site, if any is available. */
    private void attemptMove(int[] hood, int emptyNeighbors) {
        if (emptyNeighbors <= 0) return;
        int chosenCell = hood[G.rn.Int(emptyNeighbors)];
        if (G.GetAgent(chosenCell) == null) {
            MoveSQ(chosenCell);
        }
    }

    void CellStep() {
        if (type == INACTIVE_TCELL) {
            stepInactive();
        } else if (type == EXHAUSTED_TCELL) {
            stepExhausted();
        } else if (type == ACTIVE_TCELL) {
            stepActive();
        } else if (type == TUMOR) {
            stepTumor();
        }
    }

    private void stepInactive() {
        this.tcellAge += 1;

        if (G.TCE_ON) {
            this.type = ACTIVE_TCELL;
            this.hours_since_activation = 0;
            this.SetCellColor();
            return;
        }

        for (int attempt = 0; attempt < MOVE_ATTEMPTS; attempt++) {
            int[] hood = MooreHood(true);
            int emptyNeighbors = MapEmptyHood(hood);
            attemptMove(hood, emptyNeighbors);
        }

        double inactiveDivProb = (G.daysSinceTumorKill <= RECENT_KILL_WINDOW_DAYS)
                ? INACTIVE_DIV_PROB : 0.0;

        if (G.rn.Double() < inactiveDivProb) {
            int[] hood = MooreHood(true);
            int emptyNeighbors = MapEmptyHood(hood);
            if (emptyNeighbors > 0) {
                int chosenCell = hood[G.rn.Int(emptyNeighbors)];
                if (G.GetAgent(chosenCell) == null) {
                    AgentLattice child = G.NewAgentSQ(chosenCell);
                    child.type = INACTIVE_TCELL;
                    child.tcellAge = 0;
                    child.SetCellColor();
                }
            }
        }
    }

    private void stepExhausted() {
        double deathProb = ProbScale(p_death_exh, 1);

        for (int attempt = 0; attempt < MOVE_ATTEMPTS; attempt++) {
            int[] hood = MooreHood(true);
            int emptyNeighbors = MapEmptyHood(hood);
            attemptMove(hood, emptyNeighbors);
        }

        if (G.rn.Double() < deathProb) {
            this.Dispose();
            return;
        }

        if (G.TCE_ON && G.rn.Double() < P_EXHAUSTED_REACTIVATION) {
            this.type = ACTIVE_TCELL;
            this.pd_1 = this.pd_1 * 0.5;
            this.SetCellColor();
        }
    }

    private void stepActive() {
        if (G.TCE_ON) {
            this.hours_since_activation = 0;
        } else {
            this.hours_since_activation += 1;
        }
        this.tcellAge += 1;
        this.hours_since_kill += 1;
        this.hours_since_division += 1;

        for (int attempt = 0; attempt < MOVE_ATTEMPTS; attempt++) {
            int[] hood = MooreHood(true);
            int options = MapOccupiedHood(hood);
            int emptyNeighbors = MapEmptyHood(hood);
            boolean hasKilled = attemptKill(hood, options, emptyNeighbors);

            if (!hasKilled) {
                attemptMove(hood, emptyNeighbors);
            }

            if (G.rn.Double() < exhaustionProbability(this.pd_1)) {
                this.type = EXHAUSTED_TCELL;
                this.SetCellColor();
                break;
            }
        }
    }

    /** Scans occupied neighbors for a killable tumor cell and attempts the kill. */
    private boolean attemptKill(int[] hood, int options, int emptyNeighbors) {
        for (int j = 0; j < options; j++) {
            AgentLattice target = G.GetAgent(hood[j]);
            if (target == null || target.type != TUMOR || this.hours_since_kill < MIN_HOURS_BETWEEN_KILLS) {
                continue;
            }

            double killSuccessProb = 1.0 - suppressionProbability(this.pd_1);
            if (G.ACT_PHASE) {
                killSuccessProb = Math.min(1.0, killSuccessProb * ACT_PHASE_KILL_BOOST);
            }

            if (G.rn.Double() < killSuccessProb) {
                target.Tcell_Kill();
                this.hours_since_kill = 0;
                this.pd_1 += G.TCE_ON
                        ? PD1_GAIN_PER_KILL_BASE * PD1_GAIN_TCE_MULTIPLIER
                        : PD1_GAIN_PER_KILL_BASE;
                attemptDivision(hood, emptyNeighbors);
                return true;
            }
            break; // one kill attempt per movement attempt, regardless of outcome
        }
        return false;
    }

    private void attemptDivision(int[] hood, int emptyNeighbors) {
        if (emptyNeighbors <= 0 || this.hours_since_division < MIN_HOURS_BETWEEN_DIVISIONS) return;

        double divProbScale = G.ACT_PHASE ? DIV_PROB_ACT_PHASE : DIV_PROB_IN_VITRO;
        if (G.rn.Double() >= divProbScale) return;

        int chosenCell = hood[G.rn.Int(emptyNeighbors)];
        if (G.GetAgent(chosenCell) == null) {
            AgentLattice child = G.NewAgentSQ(chosenCell);
            child.type = ACTIVE_TCELL;
            child.SetCellColor();
            child.tcellAge = 0;
            child.pd_1 = this.pd_1;
            child.hours_since_division = 0;
            this.hours_since_division = 0;
        }
    }

    private void stepTumor() {
        double prolifProb = G.ACT_PHASE ? TUMOR_PROLIF_PROB_ACT : TUMOR_PROLIF_PROB_IN_VITRO;

        if (G.rn.Double() < ProbScale(prolifProb, 1)) {
            int[] hood = MooreHood(true);
            int emptyNeighbors = MapEmptyHood(hood);
            if (emptyNeighbors > 0) {
                AgentLattice child = G.NewAgentSQ(hood[G.rn.Int(emptyNeighbors)]);
                child.type = this.type;
                child.SetCellColor();
            }
        }
    }
}
