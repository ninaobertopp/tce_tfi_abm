    }

    public void InjectTransferredTcells(
            ArrayList<TcellState> transferredCells,
            int numToTransfer,
            FileIO ACTcellOutput
    ) {

        int transferred = 0;

        while (transferred < numToTransfer &&
                transferredCells.size() > 0) {

            int x = rn.Int(xDim);
            int y = rn.Int(yDim);

            if (GetAgent(x, y) == null) {

                int randomIndex =
                        rn.Int(transferredCells.size());

                TcellState state =
                        transferredCells.remove(randomIndex);

                String phenotype = "";

                if (state.type == activeTcell) {
                    phenotype = "ACTIVE";
                } else if (state.type == exhaustedTcells) {
                    phenotype = "EXHAUSTED";
                } else if (state.type == inactiveTcell) {
                    phenotype = "INACTIVE";
                }

                ACTcellOutput.Write(
                        transferred + "," +
                                phenotype + "," +
                                state.pd_1 + "," +
                                state.tcellAge + "," +
                                state.hours_since_activation + "," +
                                state.hours_since_division + "," +
                                state.hours_since_kill + "\n"
                );

                agentLattice cell = NewAgentSQ(x, y);

                cell.type = state.type;

                cell.pd_1 = state.pd_1;

                cell.tcellAge = state.tcellAge;

                cell.hours_since_activation =
                        state.hours_since_activation;

                cell.hours_since_division =
                        state.hours_since_division;

                cell.hours_since_kill =
                        state.hours_since_kill;

                cell.SetCellColor();

                transferred++;
            }
        }

        System.out.println(
                "Transferred T cells = " + transferred
        );
    }

    // Save a PNG of the current grid state at logical resolution x scale
    public void savePNG(String filePath, int scale) {
        int w = xDim * scale, h = yDim * scale;
        BufferedImage img = new BufferedImage(w, h, BufferedImage.TYPE_INT_ARGB);
        // draw each lattice cell as a scale x scale block
        for (int x = 0; x < xDim; x++) {
            for (int y = 0; y < yDim; y++) {
                agentLattice a = GetAgent(x, y);
                int col = (a != null) ? a.color : RGB256(240, 220, 220); // same bg as UI
                int argb = 0xFF000000 | (col & 0x00FFFFFF);              // ensure opaque alpha
                int x0 = x * scale, y0 = y * scale;
                for (int dx = 0; dx < scale; dx++) {
                    for (int dy = 0; dy < scale; dy++) {
                        img.setRGB(x0 + dx, y0 + dy, argb);
                    }
                }
            }
        }
        try {
            ImageIO.write(img, "png", new File(filePath));
        } catch (IOException e) {
            e.printStackTrace();
        }
    }


    public void ModelStep(double timeStep, double day) {
        this.timeStep = (int) timeStep;
        cached_CD8_TIL_count = CellCounts()[0];  // Total CD8 T cells (active + exhausted + inactive)

        ShuffleAgents(rn);
        for (agentLattice c : this) {
            c.CellStep();
        }

        // ✅ Recalculate tumor counts directly
        totalTumorCells = 0;
        for (agentLattice c : this) {
            if (c.type == Tumor) {
                totalTumorCells++;
            }
        }

        // ✅ Daily logic (only every 24 hours)
        if (timeStep % 24 == 0 && timeStep != 0) {

            int currentDay = (int) (timeStep / 24);


            // Reset tumor cells every 7 days (Day 7, 14, 21, 28, 35, ...)
            if (!ACT_PHASE &&
                    timeStep % (7 * 24) == 0) {

                ResetTumorsToETRatio(4.0);
            }

            // === T cell reversion (active → inactive) based on half-life decay ===
            if (!TCE_ON) {
                for (agentLattice cell : this) {
                    if (cell.type == activeTcell && cell.hours_since_activation >= 24) {

                        double t_days = cell.hours_since_activation / 24.0;
                        double t_half_days = 210.0 / 24.0;
                        double decayProb = 1.0 - Math.exp(-Math.log(2) * t_days / t_half_days);

                        if (rn.Double() < decayProb) {
                            cell.type = inactiveTcell;
                            cell.SetCellColor(); // preserve PD-1, age, etc.
                        }
                    }
                }
            }
        }
    }

