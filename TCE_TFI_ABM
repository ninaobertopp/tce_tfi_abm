                            win.TickPause(100);
                        }

                        /////////////////////////////////////////////////////////
                        // APPLY BIOLOGY
                        /////////////////////////////////////////////////////////

                        transferGrid.ModelStep(t, ACT_Day);

                        /////////////////////////////////////////////////////////
                        // END-OF-DAY OUTPUT
                        // (matches in vitro logic)
                        /////////////////////////////////////////////////////////

                        if (t % 24 == 0) {

                            double[] transferCounts =
                                    transferGrid.CellCounts();

                            System.out.println("ACT Phase");

                            transferGrid.PrintDailyStatus(ACT_Day);

                            transferGrid.RecordOut(
