    //Output numbers of cell populations
    public double[] CellCounts() {
        // [0]=Total CD8 TILs, [1]=Total Tumor,
        // [2]=Active, [3]=Exhausted, [4]=Inactive,
        // [5]=% Exhausted
        double[] counts = new double[6];

        for (agentLattice c : this) {
            if (c.type == activeTcell) {
                counts[2]++;
            } else if (c.type == exhaustedTcells) {
                counts[3]++;
            } else if (c.type == inactiveTcell) {
                counts[4]++;
            } else if (c.type == Tumor) {
                counts[1]++;
            }
        }

        // Total CD8 T cells
        counts[0] = counts[2] + counts[3] + counts[4];

        // % exhausted T cells
        double totalT = counts[0];
        counts[5] = (totalT > 0) ? (counts[3] / totalT) * 100.0 : 0.0;

        return counts;
    }

    public ArrayList<TcellState> HarvestTcells() {

        ArrayList<TcellState> harvested = new ArrayList<>();

        for (agentLattice c : this) {

            if (
                    c.type == activeTcell ||
                            c.type == exhaustedTcells ||
                            c.type == inactiveTcell
            ) {

                TcellState state = new TcellState(

                        c.type,

                        c.pd_1,

                        c.tcellAge,

                        c.hours_since_activation,

                        c.hours_since_division,

                        c.hours_since_kill
                );

                harvested.add(state);
            }
        }

        return harvested;
    }

    public void ResetTumorsToETRatio(double targetRatio) {
        // targetRatio = tumor cells per T cell, e.g. 4.0 for E:T = 1:4


        int tCellCount = 0;

        for (agentLattice c : this) {
            if (c.type == activeTcell || c.type == inactiveTcell || c.type == exhaustedTcells) {
                tCellCount++;
            }
        }

        for (agentLattice c : this) {
            if (c.type == Tumor) {
                c.Dispose();
            }
        }

        int targetTumorCells = (int) (targetRatio * tCellCount);

        int emptySites = (xDim * yDim) - tCellCount;
        targetTumorCells = Math.min(targetTumorCells, emptySites);

        for (int i = 0; i < targetTumorCells; i++) {
            int x, y;
            do {
                x = rn.Int(xDim);
                y = rn.Int(yDim);
            } while (GetAgent(x, y) != null);

            agentLattice tumor = NewAgentSQ(x, y);
            tumor.type = Tumor;
            tumor.SetCellColor();
        }

        totalTumorCells = targetTumorCells;
    }

    public void RecordOut(
            FileIO writeHere,
            int time,
            double[] cts,
            boolean tceOnFlag
    ) {

        writeHere.Write(time + ",");

        for (int i = 0; i < cts.length; i++) {

            writeHere.Write(
                    String.format("%.2f", cts[i])
            );

            writeHere.Write(",");
        }

        writeHere.Write(
                (tceOnFlag ? "true" : "false") + "\n"
        );
    }

