    public static final int activeTcell = 1;      // active CD8 T cells
    public static final int exhaustedTcells = 4;  // exhausted CD8 T cells
    public static final int Tumor = 2;            // tumor cells
    public static final int inactiveTcell = 6;    // inactive T cells

    public double cached_CD8_TIL_count = 0;
    public int totalTumorCells = 0; // tracks all tumor cells
    public int daysSinceTumorKill = 4;


    // Exhausted T cell death rate (per hour)
    // Calibrated to yield ~40% cumulative death over 10 days (240 h),
    // assuming exponential decay: survival = exp(-r * t) → r ≈ 0.00213 h⁻¹
    // Based on in vitro CD8⁺ T cell survival kinetics:
    // Hedfors & Brinchmann, Scand J Immunol (2003)
    public double T_CELL_DEATH_RATE = 1.0 / 96.0; //0.00213;

    boolean TCE_ON; // indicates whether TCE therapy is currently active

    boolean ACT_PHASE = false;

    // TCE dosing schedule defined by start days and duration (in days)
// Each entry in TCE_start corresponds to one treatment-on period.
// The matching entry in TCE_Duration defines how long TCE remains on.
//
// Example shown: TFI_7 schedule (7 days on, 7 days off, repeated)
    double[] TCE_start = {1, 15};      // TCE on during Days 1–7 and 15–21
    double[] TCE_Duration = {7, 7};    // each treatment period lasts 7 days

    /* Alternative schedules:

    // Continuous (CONT): TCE on for the full 28-day treatment phase
    TCE_start    = {1};
    TCE_Duration = {28};

    // TFI_2: 2 days on, 2 days off
    TCE_start    = {1, 5, 9, 13, 17, 21, 25};
    TCE_Duration = {2, 2, 2, 2, 2, 2, 2};

    // TFI_3: 3 days on, 3 days off
    TCE_start    = {1, 7, 13, 19, 25};
    TCE_Duration = {3, 3, 3, 3, 3};

    // Extended example with multiple cycles beyond 28 days
    TCE_start    = {1, 7, 13, 19, 25, 43, 49, 55, 61, 67};
    TCE_Duration = {3, 3, 3, 3, 3, 3, 3, 3, 3, 3};

    // Repeated 7-day on/off cycles across a longer simulation
    TCE_start    = {1, 15, 43, 57};
    TCE_Duration = {7, 7, 7, 7};

    */
    public Rand rn = new Rand();
    FileIO output;

    ////////////////////
    //GRID CONSTRUCTOR//
