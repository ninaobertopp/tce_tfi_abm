class TcellState {

    int type;

    double pd_1;

    double tcellAge;

    double hours_since_activation;

    double hours_since_division;

    double hours_since_kill;

    public TcellState(
            int type,
            double pd_1,
            double tcellAge,
            double hours_since_activation,
            double hours_since_division,
            double hours_since_kill
    ) {

        this.type = type;

        this.pd_1 = pd_1;

        this.tcellAge = tcellAge;

        this.hours_since_activation = hours_since_activation;

        this.hours_since_division = hours_since_division;

        this.hours_since_kill = hours_since_kill;
    }
}

//////////////
//CELL CLASS//
//////////////
class agentLattice extends AgentSQ2Dunstackable<gridLattice> {
    public int type; // type of cell
    int color; // color of each cell for visualization
    double pd_1 = 0; // pd_1 for tcells
    double tcellAge = 0; // used for tracking the age of a tcell
    double hours_since_kill = 0; // hours since a tcell last killed a tumor cell
    public double hours_since_activation = 0;
    public double hours_since_division = 0;

    ////////////////
    //CELL METHODS//
    ////////////////
    final public static int tcell = RGB256(10, 200, 150); //tcell color
    final public static int exhausted = RGB256(200, 50, 250); //exhausted tcell color
    final public static int cancer = RGB256(47, 32, 66); // tumor cell color
    final public static int inactivetcell = RGB256(255, 165, 0);

    public static int CategorialColor(int index) {
        switch (index) {
            case activeTcell:
                return tcell;
            case exhaustedTcells:
                return exhausted;
            case Tumor:
                return cancer;
            case inactiveTcell:
                return inactivetcell;
            default:
                throw new IllegalArgumentException("index outside color category range index: " + index);
        }
    }

    void SetCellColor() {
        color = CategorialColor((int) Math.round(0 + type));
    }

    void Tcell_Kill() {
        if (type == Tumor) {
            if (G.totalTumorCells > 0) { // Prevent negative count
                G.totalTumorCells--;
            }
        }
        G.daysSinceTumorKill = 0;
        this.Dispose();
    }


    void CellStep() {
        // Movement attempts scale with environment:
        // more attempts in vivo (ACT phase) to reflect circulatory transport
        int moveAttempts = G.ACT_PHASE ? 6 : 3;

        if (type == inactiveTcell) {
            this.tcellAge += 1;
            if (G.TCE_ON) {
                this.type = activeTcell;
                this.hours_since_activation = 0;
                this.SetCellColor(); // Update cell color after type change
                return;
            }

            // === Alloreactive killing during ACT phase (PD-1 dependent) ===
            if (G.ACT_PHASE) {
                int[] killHood = MooreHood(true);
                int neighbors = MapOccupiedHood(killHood);
                for (int j = 0; j < neighbors; j++) {
                    agentLattice target = G.GetAgent(killHood[j]);
                    if (target != null && target.type == Tumor) {
                        // Same sigmoid as active T cells — boosted for in vivo lysis sensitivity
                        double suppressionProb =
                                1.0 / (1.0 + Math.exp(-0.7 * (this.pd_1 - 10.0)));
                        double killSuccessProb = Math.min(1.0, (1.0 - suppressionProb) * 2.0);

                        // Alloreactivity is rare — cap maximum kill chance regardless of PD-1
                        double ALLO_MAX = 0.02;
                        killSuccessProb = Math.min(killSuccessProb, ALLO_MAX);

                        if (G.rn.Double() < killSuccessProb) {
                            target.Tcell_Kill();

                            // PD-1 accumulates on kill, same as active
                            this.pd_1 += 1.0;

                            // transition to active if they're killing
                            this.type = activeTcell;
                            this.SetCellColor();
                        }
                        break; // one attempt per step regardless of outcome
                    }
                }
            }

            double inactiveDivProb = 0.0;

            if (G.daysSinceTumorKill <= 3) {
                inactiveDivProb = 1.0 / 120.0;
            }

            if (G.rn.Double() < inactiveDivProb) {
                int[] divHood = MooreHood(true);
                int emptyNeighbors = MapEmptyHood(divHood);

                if (emptyNeighbors > 0) {
                    int chosenIndex = G.rn.Int(emptyNeighbors);
                    int chosenCell = divHood[chosenIndex];

                    if (G.GetAgent(chosenCell) == null) {
                        agentLattice child = G.NewAgentSQ(chosenCell);
                        child.type = inactiveTcell;
                        child.tcellAge = 0;
                        child.SetCellColor();
                    }
                }
            }
// Each T cell performs up to x movement/interaction attempts per timestep
            for (int attempt = 0; attempt < moveAttempts; attempt++) {
                int[] movdivHood = MooreHood(true); // for division and movement
                int emptyNeighbors = MapEmptyHood(movdivHood); // mapping empty spots
                if (emptyNeighbors > 0) {
                    int chosenIndex = G.rn.Int(emptyNeighbors); // Randomly choose an empty cell index
                    int chosenCell = movdivHood[chosenIndex]; // Get the chosen empty cell
                    if (G.GetAgent(chosenCell) == null) { // Check if the chosen cell is still empty
                        MoveSQ(chosenCell);
                    }
                }
            }
        }

        if (type == exhaustedTcells) {
            double rn_BirthDeath = G.rn.Double();
            double deathRate = G.T_CELL_DEATH_RATE;
            double deathProb = ProbScale(deathRate, 1);  // Calculate probability


            if (rn_BirthDeath < deathProb) {  // Check if cell should die
                this.Dispose();
                return;
            }

            for (int attempt = 0; attempt < moveAttempts; attempt++) {
                int[] movdivHood = MooreHood(true); // for division and movement
                int emptyNeighbors = MapEmptyHood(movdivHood); // mapping empty spots
                if (emptyNeighbors > 0) {
                    int chosenIndex = G.rn.Int(emptyNeighbors); // Randomly choose an empty cell index
                    int chosenCell = movdivHood[chosenIndex]; // Get the chosen empty cell
                    if (G.GetAgent(chosenCell) == null) { // Check if the chosen cell is still empty
                        MoveSQ(chosenCell);
                    }
                }
            }

            //Define the percentage of cells to turn into active T cells
            double activationProbability = 0.0005; // low probability of exhausted-to-active reactivation under TCE
            if (G.TCE_ON) {
                // Generate a random number between 0 and 1
                // Only turn into activeTcell if the random number is less than the activationProbability
                if (G.rn.Double() < activationProbability) {
                    this.type = activeTcell;
                    this.SetCellColor(); // Update cell color after type change
                    this.pd_1 = 0.25;
                    this.SetCellColor();
                }
            }
        }

        if (type == activeTcell) {

            // =========================
            // TCE decay / activation tracking
            // =========================
            if (G.TCE_ON) {
                this.hours_since_activation = 0;
            } else {
                this.hours_since_activation += 1;
            }

            // =========================
            // Update clocks
            // =========================
            this.tcellAge += 1;
            this.hours_since_kill += 1;
            this.hours_since_division += 1;

            // =========================
            // Up to 3 movement / interaction attempts
            // =========================
            for (int attempt = 0; attempt < moveAttempts; attempt++) {

                int[] movdivHood = MooreHood(true);

                int options = MapOccupiedHood(movdivHood);
                int emptyNeighbors = MapEmptyHood(movdivHood);

                boolean hasKilled = false;

                // =========================
                // Scan neighboring cells
                // =========================
                for (int j = 0; j < options; j++) {

                    agentLattice target = G.GetAgent(movdivHood[j]);

                    if (target != null &&
                            target.type == Tumor &&
                            this.hours_since_kill >= 12) {

                        // =========================
                        // PD-1 dependent suppression
                        // =========================

                        // sigmoid:
                        // low PD-1 -> low suppression
                        // high PD-1 -> high suppression

                        double suppressionProb =
                                1.0 / (1.0 + Math.exp(-0.7 * (this.pd_1 - 10.0)));

                        double killSuccessProb = 1.0 - suppressionProb;

                        if (G.ACT_PHASE) {
                            killSuccessProb = Math.min(1.0, killSuccessProb * 2.0);
                        }

                        boolean canKill = false;

                        if (G.rn.Double() < killSuccessProb) {
                            canKill = true;
                        }

                        // =========================
                        // Successful kill
                        // =========================
                        if (canKill) {

                            target.Tcell_Kill();

                            hasKilled = true;

                            this.hours_since_kill = 0;

                            // =========================
                            // PD-1 accumulation
                            // =========================

                            double EXH_INCREMENT_BASE = 1.0;
                            double EXH_TCE_FACTOR = 2.0;

                            if (G.TCE_ON) {
                                this.pd_1 +=
                                        EXH_INCREMENT_BASE * EXH_TCE_FACTOR;
                            } else {
                                this.pd_1 += EXH_INCREMENT_BASE;
                            }

                            // =========================
                            // T-cell proliferation
                            // =========================
                            if (emptyNeighbors > 0 &&
                                    this.hours_since_division >= 5) {

                                double divProbScale;

                                if (G.ACT_PHASE) {

                                    // in vivo / ACT phase
                                    divProbScale = 1.0;

                                } else {

                                    // in vitro phase
                                    divProbScale = 0.10;
                                }

                                if (G.rn.Double() < divProbScale) {

                                    int chosenIndex =
                                            G.rn.Int(emptyNeighbors);

                                    int chosenCell =
                                            movdivHood[chosenIndex];

                                    if (G.GetAgent(chosenCell) == null) {

                                        agentLattice child =
                                                G.NewAgentSQ(chosenCell);

                                        child.type = activeTcell;

                                        child.SetCellColor();

                                        child.tcellAge = 0;

                                        child.pd_1 = this.pd_1;

                                        child.hours_since_division = 0;

                                        this.hours_since_division = 0;

                                    }
                                }
                            }

                            // stop scanning after successful kill
                            break;
                        }
                    }
                }

                // =========================
                // Movement if no kill occurred
                // =========================
                if (!hasKilled && emptyNeighbors > 0) {

                    int chosenIndex = G.rn.Int(emptyNeighbors);

                    int chosenCell = movdivHood[chosenIndex];

                    if (G.GetAgent(chosenCell) == null) {

                        MoveSQ(chosenCell);
                    }
                }

                // =========================
                // Exhaustion transition
                // =========================
                double exhaustionProb =
                        1.0 / (1.0 + Math.exp(-0.7 * (this.pd_1 - 14.0)));

                if (G.rn.Double() < exhaustionProb) {

                    this.type = exhaustedTcells;

                    this.SetCellColor();

                    break;
                }
            }
        }

        if (type == Tumor) {

//            if (G.ACT_PHASE) {
//                // ALL blasts are motile in vivo
//                for (int attempt = 0; attempt < moveAttempts; attempt++) {
//                    int[] movHood = MooreHood(true);
//                    int emptyNeighbors = MapEmptyHood(movHood);
//                    if (emptyNeighbors > 0) {
//                        int chosenCell = movHood[G.rn.Int(emptyNeighbors)];
//                        if (G.GetAgent(chosenCell) == null) {
//                            MoveSQ(chosenCell);
//                        }
//                    }
//                }
//            }

            double adjusted_prolif_prob;

            /////////////////////////////////////////////////////////
            // PHASE-DEPENDENT TUMOR PROLIFERATION
            /////////////////////////////////////////////////////////

            if (G.ACT_PHASE) {

                // in vivo ACT tumors proliferate
                adjusted_prolif_prob = 1.0 / 72.0;

            } else {

                // irradiated in vitro tumors remain static
                adjusted_prolif_prob = 0.0;
            }

            /////////////////////////////////////////////////////////
            // Tumor division
            /////////////////////////////////////////////////////////

            if (G.rn.Double() < ProbScale(adjusted_prolif_prob, 1)) {

                int[] divHood = MooreHood(true);

                int emptyNeighbors = MapEmptyHood(divHood);

                // Create daughter tumor cell
                if (emptyNeighbors > 0) {

                    agentLattice child =
                            G.NewAgentSQ(
                                    divHood[G.rn.Int(emptyNeighbors)]
                            );

                    child.type = this.type;

                    child.SetCellColor();
                }
            }
        }
    }
